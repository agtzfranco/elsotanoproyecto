# URL del proyecto de Supabase (Project Settings > API)
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Service role key (Project Settings > API). NUNCA exponerla al frontend.
SUPABASE_SERVICE_ROLE_KEY=

# Secreto para firmar los JWT de sesión (usa una cadena larga y aleatoria)
JWT_SECRET=

# Puerto del servidor
PORT=3000

# Origen permitido para CORS cuando el frontend se sirve por separado
# (déjalo vacío si el backend sirve el frontend estático desde /public)
CORS_ORIGIN=

# development | production (en production la cookie de sesión requiere HTTPS)
NODE_ENV=development

# Datos del admin inicial para "npm run seed:admin"
ADMIN_NOMBRE=Staff El Sótano
ADMIN_EMAIL=admin@elsotano.com
ADMIN_PASSWORD=CambiaEstaClave123
