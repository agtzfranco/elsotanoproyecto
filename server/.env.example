# URL del proyecto de Supabase (Project Settings > API)
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Service role key (Project Settings > API). NUNCA exponerla al frontend.
SUPABASE_SERVICE_ROLE_KEY=

# Secreto para firmar los JWT de sesión (usa una cadena larga y aleatoria)
JWT_SECRET=

# Puerto del servidor
PORT=3000

# Origen permitido para CORS cuando el frontend se sirve por separado
# (déjalo vacío si el backend sirve el frontend estático desde /public)
CORS_ORIGIN=

# development | production (en production la cookie de sesión requiere HTTPS)
NODE_ENV=development

# URL pública del sitio, para los enlaces de los correos (p. ej. https://elsotano.mx).
# Si se deja vacía se usa el dominio desde el que llegó la solicitud.
SITE_URL=

# Zona horaria del estudio (para no dejar reservar horas que ya pasaron)
ZONA_HORARIA=America/Mexico_City

# Correos con Resend (https://resend.com). Sin estas variables las reservas
# funcionan igual, pero no se envían avisos.
RESEND_API_KEY=
# Remitente verificado en Resend, p. ej. "El Sótano <reservas@elsotano.mx>"
CORREO_REMITENTE=
# Correo del staff que recibe el aviso de cada reserva nueva
CORREO_STAFF=

# Datos del admin inicial para "npm run seed:admin"
ADMIN_NOMBRE=Staff El Sótano
ADMIN_EMAIL=admin@elsotano.com
ADMIN_PASSWORD=CambiaEstaClave123

# Ruta secreta del login del staff (mínimo 12 letras, números, - o _).
# El login queda en http://localhost:3000/<STAFF_PATH>; /login da 404.
STAFF_PATH=
